# ==============================================================================
# IFPTIE MARKET - CONFIGURATION SUPABASE (CAMEROUN)
# ==============================================================================
# Créez votre projet gratuit sur https://supabase.com
# Copiez ce fichier sous le nom .env ou .env.local et renseignez vos identifiants :

# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé API publique Anonyme (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique-ici
